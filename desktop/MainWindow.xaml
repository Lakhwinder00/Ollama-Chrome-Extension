<Window x:Class="MyAgent.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Local AI Coding Agent"
        Height="800" Width="1150"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E" Foreground="#E8E6E3"
        TextElement.Foreground="#E8E6E3"
        TextElement.FontFamily="Segoe UI,Helvetica,Arial,sans-serif">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="◮" Foreground="#D97757" FontSize="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="Local AI Coding Agent" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock x:Name="ConnLabel" Text="● connecting…" Foreground="#9A9A9A" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox x:Name="ModelCombo" Width="240" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Button x:Name="RefreshModelsBtn" Content="⟳" Width="30" Click="RefreshModels_Click"/>
                <Button x:Name="CloseBtn" Content="×" Width="30" HorizontalAlignment="Right" Click="CloseBtn_Click"
                        Background="#4A4A4A" Foreground="#888888" BorderThickness="0" Margin="4,0,0,0"/>
            </StackPanel>
        </DockPanel>

        <!-- Project + server -->
        <Grid Grid.Row="1" Margin="0,18,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Project:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#9A9A9A"/>
            <TextBox x:Name="ProjectBox" Grid.Column="1" Margin="0,0,6,0" Padding="6,4"
                     Background="#2B2B31" Foreground="#E8E6E3" BorderBrush="#3A3A42"/>
            <Button x:Name="SetProjectBtn" Grid.Column="2" Content="Set" Padding="12,4" Margin="0,0,8,0"
                    Background="#2B2B31" Foreground="#E8E6E3" BorderBrush="#3A3A42" Click="SetProject_Click"/>
            <TextBox x:Name="ServerBox" Grid.Column="3" Width="200" Padding="6,4" Text="http://127.0.0.1:8787"
                     Background="#2B2B31" Foreground="#E8E6E3" BorderBrush="#3A3A42"/>
        </Grid>

        <!-- Chat -->
        <ScrollViewer Grid.Row="2" x:Name="ChatScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="ChatPanel"/>
        </ScrollViewer>

        <!-- Approval banner -->
        <Border Grid.Row="3" x:Name="ApprovalBar" Visibility="Collapsed"
                Background="#2A221E" BorderBrush="#D97757" BorderThickness="0,1,0,0" Padding="10" Margin="0,10,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" MaxWidth="720">
                    <TextBlock x:Name="ApprovalName" Foreground="#D97757" FontWeight="Bold"/>
                    <TextBlock x:Name="ApprovalArgs" Foreground="#9A9A9A" TextWrapping="Wrap" FontSize="11" MaxHeight="60"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="ApproveBtn" Content="Once" Click="Approve_Click" ToolTip="Allow this single call" Margin="0,0,6,0"
                            Background="#D97757" Foreground="#1E1E1E" BorderThickness="0" Padding="14,6"/>
                    <Button x:Name="SessionBtn" Content="Session" Click="Session_Click" ToolTip="Allow for this session" Margin="0,0,6,0"
                            Background="#2B2B31" Foreground="#D97757" BorderBrush="#D97757" Padding="14,6"/>
                    <Button x:Name="AlwaysBtn" Content="Always" Click="Always_Click" ToolTip="Always allow (saved)" Margin="0,0,6,0"
                            Background="#2B3A2E" Foreground="#9FE8A8" BorderBrush="#4A6B50" Padding="14,6"/>
                    <Button x:Name="DenyBtn" Content="Deny" Click="Deny_Click"
                            Background="#2B2B31" Foreground="#E8E6E3" BorderBrush="#3A3A42" Padding="14,6"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Input -->
        <DockPanel Grid.Row="4" Margin="0,18,0,0">
            <Button x:Name="StopBtn" DockPanel.Dock="Right" Content="■ Stop" Click="Stop_Click"
                    Width="76" Margin="6,0,0,0" Background="#E06C6C" Foreground="#1E1E1E" BorderThickness="0"
                    Visibility="Collapsed"/>
            <Button x:Name="SendBtn" DockPanel.Dock="Right" Content="Send ➤" Click="Send_Click"
                    Width="86" Margin="6,0,0,0" Background="#D97757" Foreground="#1E1E1E" BorderThickness="0"/>
            <TextBox x:Name="InputBox" KeyDown="InputBox_KeyDown" Padding="8,6"
                     Background="#2B2B31" Foreground="#E8E6E3" BorderBrush="#3A3A42"
                     VerticalContentAlignment="Center" TextWrapping="Wrap"/>
        </DockPanel>
    </Grid>
</Window>