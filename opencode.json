{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/bonsai-27b",
  "small_model": "ollama/qwen3-coder:30b",
  "default_agent": "build",
  "autoupdate": false,
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama",
      "options": {
        "baseURL": "http://localhost:11434/v1",
        "timeout": false
      },
      "models": {
        "qwen3.5:9b ": {
          "name": "qwen3.5:9b",
          "tools": true,
          "limit": {
            "context": 32768,
            "output": 4096
          },
          "options": {
            "temperature": 0.2
          }
        },
        "qwen3-coder:30b": {
          "name": "Qwen 30B Coder",
          "tools": true,
          "limit": {
            "context": 32768,
            "output": 4096
          },
          "options": {
            "temperature": 0.2
          }
        },
        "glm-4.7-flash:latest": {
          "name": "GLM 4.7 Flash",
          "tools": true,
          "limit": {
            "context": 16384,
            "output": 4096
          }
        }
      }
    }
  },
  "permission": {
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "bash": "allow",
    "task": "deny",
    "todowrite": "allow",
    "webfetch": "deny",
    "websearch": "deny"
  }
}